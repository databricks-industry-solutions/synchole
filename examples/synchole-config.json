      "profileName": "source-change-tables",
      "description": "Change tables: one audit table per source table",
      "method": "change_table",
      "changeTableName": "audit.{table_lower}_changes",
      "sequenceColumn": "CHANGE_SEQ",
      "deleteFlagColumn": "IS_DELETED",
      "changeTimeColumn": "CHANGED_AT",
      "procedureCall": null,
      "resultsTable": null
    },
    {
      "profileName": "source-change-procedure",
      "description": "Change procedure on SQL Server that fills a temp table",
      "method": "change_procedure",
      "changeTableName": null,
      "sequenceColumn": null,
      "deleteFlagColumn": null,
      "changeTimeColumn": "CHANGED_AT",
      "procedureCall": "EXEC audit.list_changed_rows @table = N'{table}', @from = {start}, @to = {end}, @into = N'{temp_table}'",
      "resultsTable": null
    }
